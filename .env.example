# This is a static site, so the browser reads its settings from
# assets/js/env.js (copy assets/js/env.example.js). These are the values
# you will need. ONLY the anon/publishable key belongs in the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SITE_URL=https://fit.yourdomain.com

# NEVER put these in env.js or any file you upload to hosting:
# SUPABASE_SERVICE_ROLE_KEY / secret key
# Database password
